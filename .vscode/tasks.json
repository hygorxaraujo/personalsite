{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "preview",
            "type": "shell",
            "command": "quarto preview --port 4200 --no-browser",
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^Browse at (http://localhost:[0-9]+)/"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Watching files for changes",
                    "endsPattern": "^Browse at http://localhost:[0-9]+/"
                }
            }
        }
    ]
}